-- PRODUCTO CARTESIANO:  En la claúsula FROM hay tablas separadas ppor coma (,)
-- SELECCIÓN: Usamos la cláusula WHERE 
-- PROYECCIÓN: En la cláusula SELECT (*) -> Es TODO o sino solo el nombre de las columnas que quiera ver.

SELECT NomMar, NomMod 
FROM marca, modelo
WHERE +marca.CodMar=modelo.CodMar;


-- CONCATENACIÓN: En la cláusula FROM usamos JOIN
/* PROYECCIÓN: En la cláusula SELECT (*) -> Es TODO o sino solo el nombre de las columnas que quiera ver
 y usamos '' par alias de columnas*/
-- Obtener las marcas y modelos pero solo de las marcas audi y seat

SELECT NomMar AS 'Marca', NomMod AS 'Modelo'
FROM marca JOIN modelo ON (marca.CodMar=modelo.CodMar);

-- Obtener las marcas y modelos pero solo de las marcas audi y seat

SELECT NomMar AS 'Marca', NomMod AS 'Modelo'
FROM marca JOIN modelo ON (marca.CodMar=modelo.CodMar)
WHERE NomMar = 'Audi' OR NomMar = 'Seat' ;


CREATE TABLE coche_malaga
(
CodCoc INT NOT NULL,
MatCoc VARCHAR(8) NOT NULL UNIQUE,
ColCoc VARCHAR(50) NOT NULL DEFAULT 'blanco',
PueCoc TINYINT NOT NULL,
CvCoc TINYINT  NOT NULL,
CilCoc SMALLINT NOT NULL,
AntCoc DATE NOT NULL,
CodMod INT NOT NULL,
PRIMARY KEY (CodCoc),
FOREIGN KEY (CodMod) REFERENCES modelo(CodMod)
);

CREATE TABLE coche_sevilla
(
CodCoc INT NOT NULL,
MatCoc VARCHAR(8) NOT NULL UNIQUE,
ColCoc VARCHAR(50) NOT NULL DEFAULT 'blanco',
PueCoc TINYINT NOT NULL,
CvCoc TINYINT  NOT NULL,
CilCoc SMALLINT NOT NULL,
AntCoc DATE NOT NULL,
CodMod INT NOT NULL,
PRIMARY KEY (CodCoc),
FOREIGN KEY (CodMod) REFERENCES modelo(CodMod)
);

