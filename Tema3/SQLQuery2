--UNION
--Obtener los coches de los concesionarios de Málaga y Sevilla

SELECT ColCoc
FROM coche_malaga
UNION ALL
SELECT ColCoc
FROM coche_sevilla;

--INTERSECCIÓN 
-- Obtener los colores que están tanto en Málaga como en Sevilla

SELECT ColCoc
FROM coche_malaga
INTERSECT
SELECT ColCoc
FROM coche_sevilla;


-- EXCEPCIÓN
-- Obtener los colores que están tanto en Málaga y no en Sevilla

SELECT ColCoc
FROM coche_malaga
EXCEPT
SELECT ColCoc
FROM coche_sevilla;
